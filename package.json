{
  "name": "vue-portfolio",
  "version": "0.0.0",
  "description": "Personal portfolio of Praveen Kumar, a Front-end Developer & Gen AI Enthusiast. Built with Vue.js 3 and Glassmorphism UI.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:v3": "vite --config vite.v3.config.js",
    "build": "npm run build:v3 && node scripts/build-deploy.mjs",
    "build:v3": "vite build --config vite.v3.config.js",
    "build:source": "vite build",
    "preview": "vite preview",
    "preview:deploy": "npx wrangler pages dev dist",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name praveen-portfolio"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "marked": "^18.1.2",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5"
  }
}
